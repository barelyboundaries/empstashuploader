# --- local runtime artifacts (never ship) ---
runtime/
config.local.*
*.secret
*.key
*.env
__pycache__/
.pytest_cache/
*.egg-info/
.venv/
node_modules/

# Browser/leveldb dumps pulled in while debugging the plugin UI. These can
# carry session data and must never reach a public repo.
*.ldb
*.ldb.extracted.js

# --- workspace tooling (dev-only, never ship) ---
.agents/
.codegraph/
.omo/
.playwright-mcp/
test-results/
.mcp.json
.mcp.json.bak

# --- build output ---
dist/
*.zip
